{
  "name": "qvac-sovereign-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local bilingual call-center copilot powered by QVAC and TranslatePsy",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node --experimental-strip-types scripts/doctor.ts",
    "smoke:translate": "node --experimental-strip-types scripts/smoke-translate.ts",
    "smoke:rag": "node --experimental-strip-types scripts/smoke-rag.ts",
    "smoke:flow": "node --experimental-strip-types scripts/smoke-flow.ts",
    "smoke:asr": "node --experimental-strip-types scripts/smoke-asr.ts",
    "evaluate:rag": "node --experimental-strip-types scripts/evaluate-rag.ts",
    "capture:ui": "node scripts/capture-ui.mjs"
  },
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.2"
  },
  "dependencies": {
    "@qvac/sdk": "^0.19.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
